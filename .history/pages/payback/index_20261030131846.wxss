.page {
  /* 底部留出 tabBar 高度 + iPhone 安全区 */
  padding: 0 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

/* ================= 结论区 ================= */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #1e293b, #0f172a);
  border-radius: 0 0 32rpx 32rpx;
  padding: 0 36rpx 32rpx;
  color: #fff;
  margin: 0 -24rpx 24rpx;
}

.hero-glow-a,
.hero-glow-b {
  position: absolute;
  border-radius: 999px;
  filter: blur(80rpx);
  opacity: 0.25;
}
.hero-glow-a {
  top: -120rpx;
  right: -120rpx;
  width: 400rpx;
  height: 400rpx;
  background: #3b82f6;
}
.hero-glow-b {
  bottom: -100rpx;
  left: -100rpx;
  width: 320rpx;
  height: 320rpx;
  background: #6366f1;
}

.hero-eyebrow {
  position: relative;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #93c5fd;
  padding-top: 20rpx;
}

.hero-headline {
  position: relative;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -1rpx;
  margin: 12rpx 0 8rpx;
  background: linear-gradient(90deg, #bfdbfe, #ffffff);
  -webkit-background-clip: text;
  color: transparent;
}

.hero-sub {
  position: relative;
  font-size: 24rpx;
  line-height: 1.7;
  color: #cbd5e1;
}

.hero-alt {
  position: relative;
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(148, 163, 184, 0.18);
  font-size: 22rpx;
  line-height: 1.6;
  color: #e2e8f0;
}

.preset-row {
  position: relative;
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
}

.preset-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 0;
  border-radius: 999px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: rgba(255, 255, 255, 0.06);
  color: #cbd5e1;
}

.preset-btn.active {
  border-color: #60a5fa;
  background: rgba(59, 130, 246, 0.28);
  color: #ffffff;
}

.hero-note {
  position: relative;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 16rpx;
}

/* ================= 卡片 ================= */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  color: #9ca3af;
  border-bottom: 1px solid #f0f0f0;
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

.card-note {
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.6;
  margin-top: 16rpx;
}

/* ================= 对比表 ================= */
.cmp {
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  overflow: hidden;
}

.cmp-row {
  display: flex;
  align-items: center;
  border-top: 1px solid #f1f5f9;
}

.cmp-row.cmp-head {
  border-top: none;
  background: #f8fafc;
}

.cmp-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #374151;
  padding: 18rpx 6rpx;
}

.cmp-label {
  flex: 1.2;
  text-align: left;
  padding-left: 20rpx;
  color: #6b7280;
}

.cmp-head .cmp-cell {
  font-size: 22rpx;
  font-weight: 700;
  color: #64748b;
}

.cmp-best {
  color: #047857;
  font-weight: 700;
  background: #ecfdf5;
}

/* ================= 折线图 ================= */
.legend {
  display: flex;
  gap: 32rpx;
  margin-bottom: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: #6b7280;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-rent {
  background: #f59e0b;
}
.dot-buy {
  background: #3b82f6;
}

.chart {
  width: 100%;
  height: 440rpx;
  display: block;
}

.chart-note {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

/* ================= 容易漏算的钱 ================= */
.warn-card {
  background: #fffbeb;
  border: 1px solid #fde68a;
}

.warn-title {
  color: #b45309;
  border-bottom-color: #fde68a;
}

.warn-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.warn-label {
  flex-shrink: 0;
  width: 130rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #92400e;
}

.warn-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.6;
  color: #78350f;
}

/* ================= 表单 ================= */
.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #4b5563;
  margin-bottom: 12rpx;
  display: block;
}

.row-2col {
  display: flex;
  gap: 20rpx;
}

.input-block {
  flex: 1;
  min-width: 0;
}

.input-wrap {
  position: relative;
  width: 100%;
}

.text-input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  background: #f9fafb;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 96rpx 0 20rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.input-unit {
  position: absolute;
  right: 20rpx;
  top: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 24rpx;
  color: #9ca3af;
  pointer-events: none;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
}

.switch-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #4b5563;
  flex: 1;
}

.tiny-switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.power-hint {
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.6;
  margin-top: 10rpx;
  padding-left: 4rpx;
}

.mini-stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-top: 20rpx;
}

.mini-stat-label {
  font-size: 22rpx;
  color: #6b7280;
}

.mini-stat-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #374151;
}

/* 输入框下方的即时换算结果 */
.live-strip {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 18rpx;
}

.live-item {
  width: 49%;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
}

.live-item-accent {
  background: #eff6ff;
  border-color: #bfdbfe;
}

.live-label {
  display: block;
  font-size: 20rpx;
  color: #6b7280;
}

.live-value {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.live-item-accent .live-value {
  color: #2563eb;
}

/* ================= 分段选择 ================= */
.seg {
  display: flex;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #6b7280;
  padding: 14rpx 0;
  border-radius: 12rpx;
}

.seg-item.active {
  background: #ffffff;
  color: #1d4ed8;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.inline-link {
  display: inline-block;
  font-size: 22rpx;
  color: #2563eb;
  font-weight: 600;
  margin-top: 14rpx;
  padding: 6rpx 0;
}

/* ================= 保本单量 ================= */
.breakeven {
  margin-top: 20rpx;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  border-radius: 16rpx;
  padding: 20rpx;
}

.breakeven-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #1d4ed8;
  margin-bottom: 10rpx;
}

.breakeven-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 24rpx;
  color: #1e40af;
}

.breakeven-note {
  font-size: 20rpx;
  color: #60a5fa;
  margin-top: 10rpx;
  line-height: 1.6;
}

/* ================= 残值 ================= */
.residual-preview {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}

.residual-preview-label {
  font-size: 22rpx;
  color: #6b7280;
}

.residual-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #047857;
}

/* ================= 操作 ================= */
.actions {
  margin-top: 8rpx;
}

.action-btn {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 999px;
}

.action-btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  box-shadow: 0 6rpx 20rpx rgba(59, 130, 246, 0.3);
}

.action-btn.ghost {
  margin-top: 16rpx;
  color: #6b7280;
  background: #ffffff;
  border: 1px solid #e5e7eb;
}

.footnote {
  font-size: 20rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.6;
  padding: 32rpx 20rpx 0;
}
