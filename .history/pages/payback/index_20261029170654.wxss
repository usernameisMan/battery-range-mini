.page {
  padding: 0 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部标题区 ---------- */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #1e293b, #0f172a);
  border-radius: 0 0 32rpx 32rpx;
  padding: 24rpx 36rpx 48rpx;
  color: #fff;
  margin: 0 -24rpx 24rpx;
}

.hero-glow {
  position: absolute;
  top: -120rpx;
  right: -120rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 999px;
  background: #6366f1;
  filter: blur(80rpx);
  opacity: 0.25;
}

.hero-tag {
  position: relative;
  display: inline-block;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(59, 130, 246, 0.3);
  border: 1px solid rgba(96, 165, 250, 0.3);
  color: #dbeafe;
  margin-top: 20rpx;
}

.hero-title {
  position: relative;
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  margin: 20rpx 0 12rpx;
}

.hero-desc {
  position: relative;
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #cbd5e1;
}

/* ---------- 卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  color: #9ca3af;
  border-bottom: 1px solid #f0f0f0;
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
}

/* ---------- 空状态 ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 40rpx 20rpx 24rpx;
}

.empty-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.7;
}

.empty-btn {
  margin-top: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d4ed8;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  padding: 16rpx 40rpx;
  border-radius: 999px;
}
