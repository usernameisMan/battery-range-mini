# ==========================================
# 微信小程序专属 Git 忽略配置
# ==========================================

# 微信开发者工具私有配置（包含个人本地开发设置，必须忽略以避免团队/多机冲突）
project.private.config.json

# 小程序 npm 构建产物及依赖包
miniprogram_npm/
node_modules/

# 编译构建输出目录（如使用构建工具或分包打包时）
dist/
build/
out/
.preview/

# 微信开发者工具运行临时缓存与日志
.tea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 操作系统自动生成文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# 常见编辑器与 IDE 配置文件
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# 本地测试与临时运行目录
scratch/
